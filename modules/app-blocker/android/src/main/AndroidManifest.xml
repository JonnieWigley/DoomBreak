<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!-- Read-only: lets the app show today's per-app screen time. Granted by the user in Settings > Usage access. -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
  <queries>
    <package android:name="com.zhiliaoapp.musically" />
    <package android:name="com.instagram.android" />
    <package android:name="com.facebook.katana" />
    <package android:name="com.twitter.android" />
    <package android:name="com.snapchat.android" />
    <package android:name="com.reddit.frontpage" />
    <package android:name="com.pinterest" />
    <package android:name="com.instagram.barcelona" />
    <package android:name="com.linkedin.android" />
  </queries>
  <application>
    <service
      android:name="expo.modules.appblocker.BlockerAccessibilityService"
      android:exported="false"
      android:label="DoomBreak"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/blocker_accessibility_config" />
    </service>
  </application>
</manifest>
